# ─── App ───────────────────────────────────────────────
APP_NAME=VendorNest
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
DEBUG=true

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://vendornest:password@localhost:5432/vendornest_db
ASYNC_DATABASE_URL=postgresql+asyncpg://vendornest:password@localhost:5432/vendornest_db

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── AWS ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vendornest-media
AWS_CLOUDFRONT_URL=https://your-cloudfront-id.cloudfront.net

# ─── Email (AWS SES) ───────────────────────────────────
SES_FROM_EMAIL=noreply@vendornest.in
SES_FROM_NAME=VendorNest
SES_REPLY_TO=support@vendornest.in

# ─── Razorpay ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Delhivery ─────────────────────────────────────────
DELHIVERY_API_KEY=your-delhivery-api-key
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_PICKUP_LOCATION=VendorNest-Warehouse

# ─── WhatsApp (Meta Cloud API) ─────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=your-meta-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ─── Auth / JWT ────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10

# ─── Superadmin ────────────────────────────────────────
SUPERADMIN_EMAIL=admin@vendornest.in
SUPERADMIN_PASSWORD=Admin@1234
SUPERADMIN_NAME=Super Admin

# ─── Defaults ──────────────────────────────────────────
DEFAULT_COMMISSION_PERCENT=5.0
DEFAULT_PAGE_SIZE=20
